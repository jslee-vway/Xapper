<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xapper.Protocol\Xapper.Protocol.csproj" />
    <ProjectReference Include="..\Xapper.Injector\Xapper.Injector.csproj" />
    <ProjectReference Include="..\Xapper.Inspector\Xapper.Inspector.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 내부 판별 로직을 공개 API로 올리지 않고 테스트에서 검증하기 위함 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Xapper.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
  </ItemGroup>

  <!-- 인젝션 페이로드 임베딩: GenericInjector + 멀티타겟 Inspector 빌드 출력물 -->
  <ItemGroup>
    <!-- GenericInjector 네이티브 DLL (아키텍처별) -->
    <EmbeddedResource Include="..\..\external\snoop-bin\Snoop.GenericInjector.x64.dll"
                      LogicalName="Xapper.Payload.Snoop.GenericInjector.x64.dll" />
    <EmbeddedResource Include="..\..\external\snoop-bin\Snoop.GenericInjector.x86.dll"
                      LogicalName="Xapper.Payload.Snoop.GenericInjector.x86.dll" />
    <EmbeddedResource Include="..\..\external\snoop-bin\Snoop.GenericInjector.ARM64.dll"
                      LogicalName="Xapper.Payload.Snoop.GenericInjector.ARM64.dll" />
    <!-- Inspector: net6.0-windows -->
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net6.0-windows\Xapper.Inspector.dll"
                      LogicalName="Xapper.Payload.net6.0-windows.Xapper.Inspector.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net6.0-windows\Xapper.Protocol.dll"
                      LogicalName="Xapper.Payload.net6.0-windows.Xapper.Protocol.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net6.0-windows\Xapper.Inspector.deps.json"
                      LogicalName="Xapper.Payload.net6.0-windows.Xapper.Inspector.deps.json" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net6.0-windows\MinHook.NET.dll"
                      LogicalName="Xapper.Payload.net6.0-windows.MinHook.NET.dll" />
    <!-- Inspector: net7.0-windows -->
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net7.0-windows\Xapper.Inspector.dll"
                      LogicalName="Xapper.Payload.net7.0-windows.Xapper.Inspector.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net7.0-windows\Xapper.Protocol.dll"
                      LogicalName="Xapper.Payload.net7.0-windows.Xapper.Protocol.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net7.0-windows\Xapper.Inspector.deps.json"
                      LogicalName="Xapper.Payload.net7.0-windows.Xapper.Inspector.deps.json" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net7.0-windows\MinHook.NET.dll"
                      LogicalName="Xapper.Payload.net7.0-windows.MinHook.NET.dll" />
    <!-- Inspector: net8.0-windows -->
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net8.0-windows\Xapper.Inspector.dll"
                      LogicalName="Xapper.Payload.net8.0-windows.Xapper.Inspector.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net8.0-windows\Xapper.Protocol.dll"
                      LogicalName="Xapper.Payload.net8.0-windows.Xapper.Protocol.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net8.0-windows\Xapper.Inspector.deps.json"
                      LogicalName="Xapper.Payload.net8.0-windows.Xapper.Inspector.deps.json" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net8.0-windows\MinHook.NET.dll"
                      LogicalName="Xapper.Payload.net8.0-windows.MinHook.NET.dll" />
    <!-- Inspector: net9.0-windows -->
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net9.0-windows\Xapper.Inspector.dll"
                      LogicalName="Xapper.Payload.net9.0-windows.Xapper.Inspector.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net9.0-windows\Xapper.Protocol.dll"
                      LogicalName="Xapper.Payload.net9.0-windows.Xapper.Protocol.dll" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net9.0-windows\Xapper.Inspector.deps.json"
                      LogicalName="Xapper.Payload.net9.0-windows.Xapper.Inspector.deps.json" />
    <EmbeddedResource Include="..\Xapper.Inspector\bin\$(Configuration)\net9.0-windows\MinHook.NET.dll"
                      LogicalName="Xapper.Payload.net9.0-windows.MinHook.NET.dll" />
  </ItemGroup>

  <!-- Inspector 는 멀티타겟이고 위에서 네 TFM 의 bin 을 모두 임베드한다. ProjectReference 는 가장 가까운 TFM(net9)만
       빌드해 나머지 TFM 의 페이로드가 낡은 채 임베드될 수 있으므로(측정 확인: net8 대상에 수정 전 DLL 이 주입됐다),
       임베드 전에 Inspector 의 외부(전 TFM) 빌드를 명시적으로 부른다. SkipGetTargetFrameworkProperties 는 dotnet publish 를
       깨뜨려(GetCopyToPublishDirectoryItems 없음) 쓰지 않는다. -->
  <Target Name="BuildInspectorAllTargetFrameworks" BeforeTargets="ResolveProjectReferences">
    <MSBuild Projects="..\Xapper.Inspector\Xapper.Inspector.csproj" Targets="Build" />
  </Target>

</Project>
